<iscontent type="text/html" charset="UTF-8" compact="true"/>
<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8"/>
        <meta name="viewport" content="width=device-width, initial-scale=1"/>
        <title>Test · Two columns</title>
        <style>
            html {
                box-sizing: border-box;
                font-family: Arial, Helvetica, sans-serif;
            }

            *,
            *::before,
            *::after {
                box-sizing: inherit;
            }

            body {
                margin: 0;
                background: #fff;
                color: #222;
            }

            .pd-component-test-page {
                width: min(100% - 2rem, 75rem);
                margin-inline: auto;
            }
        </style>
    </head>
    <body>
        <div class="pd-component-test-page">
            <isprint value="${pdict.mainRegion}" encoding="off"/>
        </div>
    </body>
</html>
