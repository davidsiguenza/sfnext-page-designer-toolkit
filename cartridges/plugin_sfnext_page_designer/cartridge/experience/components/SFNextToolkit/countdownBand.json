{
    "name": "Countdown Band · Cuenta atrás",
    "description": "Banda responsive con fecha manual o campaña Commerce, inicio y fin independientes, colores, tipografía y CTA opcional.",
    "group": "SFNextToolkit",
    "arch_type": "headless",
    "region_definitions": [],
    "attribute_definition_groups": [
        {
            "id": "countdownBand",
            "name": "Countdown Band · Cuenta atrás",
            "description": "Banda responsive con fecha manual o campaña Commerce, inicio y fin independientes, colores, tipografía y CTA opcional.",
            "attribute_definitions": [
                {
                    "id": "message",
                    "name": "Texto de la banda",
                    "type": "string",
                    "required": false,
                    "description": "Field: message",
                    "default_value": "Black Friday"
                },
                {
                    "id": "source",
                    "name": "Origen de las fechas",
                    "type": "enum",
                    "required": false,
                    "description": "Field: source",
                    "values": ["manual", "campaign"],
                    "default_value": "manual"
                },
                {
                    "id": "campaign",
                    "name": "Campaña de Commerce",
                    "type": "custom",
                    "required": false,
                    "description": "Field: campaign",
                    "editor_definition": {
                        "type": "SFNextToolkit.campaignPicker"
                    }
                },
                {
                    "id": "manualStart",
                    "name": "Inicio manual: fecha, hora y zona",
                    "type": "custom",
                    "required": false,
                    "description": "Field: manualStart",
                    "editor_definition": {
                        "type": "SFNextToolkit.countdownDate"
                    }
                },
                {
                    "id": "manualEnd",
                    "name": "Fin manual: fecha, hora y zona",
                    "type": "custom",
                    "required": false,
                    "description": "Field: manualEnd",
                    "editor_definition": {
                        "type": "SFNextToolkit.countdownDate"
                    }
                },
                {
                    "id": "showStart",
                    "name": "Mostrar cuenta atrás hasta el inicio",
                    "type": "boolean",
                    "required": false,
                    "description": "Field: showStart",
                    "default_value": true
                },
                {
                    "id": "showEnd",
                    "name": "Mostrar cuenta atrás hasta el final",
                    "type": "boolean",
                    "required": false,
                    "description": "Field: showEnd",
                    "default_value": false
                },
                {
                    "id": "startLabel",
                    "name": "Texto antes del inicio",
                    "type": "string",
                    "required": false,
                    "description": "Field: startLabel",
                    "default_value": "Empieza en"
                },
                {
                    "id": "endLabel",
                    "name": "Texto antes del final",
                    "type": "string",
                    "required": false,
                    "description": "Field: endLabel",
                    "default_value": "Termina en"
                },
                {
                    "id": "startedLabel",
                    "name": "Texto cuando ha empezado",
                    "type": "string",
                    "required": false,
                    "description": "Field: startedLabel",
                    "default_value": "Ya ha empezado"
                },
                {
                    "id": "endedLabel",
                    "name": "Texto cuando ha terminado",
                    "type": "string",
                    "required": false,
                    "description": "Field: endedLabel",
                    "default_value": "Campaña finalizada"
